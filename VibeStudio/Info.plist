<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ============================================================
         VibeStudio — Info.plist
         macOS desktop application, direct distribution (DMG).
         ============================================================ -->

    <!-- Bundle metadata -->
    <key>CFBundleName</key>
    <string>VibeStudio</string>

    <key>CFBundleDisplayName</key>
    <string>VibeStudio</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>ru</string>
    </array>

    <!-- App icon -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>

    <key>CFBundleIconName</key>
    <string>AppIcon</string>

    <!-- Application category — Developer Tools -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>

    <!-- macOS 14.0 Sonoma minimum -->
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>

    <!-- Main storyboard / SwiftUI lifecycle — no storyboard, SwiftUI App -->
    <key>NSMainStoryboardFile</key>
    <string></string>

    <!-- Principal class for AppKit integration -->
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <!-- High-resolution capable -->
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Supports automatic graphics switching (for MacBooks with dual GPU) -->
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>

    <!-- Dark/light appearance support -->
    <!-- Remove this key to support both; set to "NSAppearanceNameDarkAqua" to force dark -->

    <!-- Privacy: explain why Documents access is needed -->
    <key>NSDocumentsFolderUsageDescription</key>
    <string>VibeStudio needs access to open and monitor projects stored in your Documents folder.</string>

    <!-- Human-readable copyright -->
    <key>NSHumanReadableCopyright</key>
    <string>Copyright (c) 2026 VibeStudio Contributors. All rights reserved.</string>

    <!-- Secure coding required -->
    <key>NSRequiresAquaSystemAppearance</key>
    <false/>

    <!-- ============================================================
         Sparkle auto-update configuration
         Appcast hosted on GitHub Pages; updates verified with EdDSA.
         SUPublicEDKey is generated once via scripts/sparkle-keygen.sh
         (private key stays in the login Keychain / CI secret).
         ============================================================ -->
    <key>SUFeedURL</key>
    <string>https://alexgladkov.github.io/VibeStudio/appcast.xml</string>

    <key>SUPublicEDKey</key>
    <string>fTRMA+vy4NFD7ig8nbz7hQ4ibbJDcupGCHXBYcMRJTU=</string>

    <key>SUEnableAutomaticChecks</key>
    <true/>

    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>

    <!-- PLACEHOLDER: URL schemes for deep linking (future)
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>tech.mobiledeveloper.vibestudio</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>vibestudio</string>
            </array>
        </dict>
    </array>
    -->

    <!-- PLACEHOLDER: Document types — file associations (future)
    <key>CFBundleDocumentTypes</key>
    <array/>
    -->
</dict>
</plist>
